; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Desktop Sandbox"
run/main_scene="uid://dg0aqkh7nxccc"
run/print_header=false
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 0)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Global="*res://game/scripts/global.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=720
window/size/resizable=false
window/size/borderless=true
window/size/transparent=true
window/size/minimize_disabled=true
window/size/maximize_disabled=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/per_pixel_transparency/allowed=true

[global_group]

mouse="location of the mouse"
props="basically anything thats not ui, mouse or main scene"

